# Supabase 项目的 Project URL
# Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase 的 anon public key（可以公开在前端，安全性由 RLS 保证）
# Project Settings → API / API Keys → anon public（新版可能叫 Publishable key）
VITE_SUPABASE_ANON_KEY=your-anon-key

# 仅 GitHub Pages 自动部署时需要；本地开发不用填
# 仓库名是 together-list 时，值为 /together-list/
# VITE_BASE_PATH=/together-list/
